# Copier ce fichier en .streamlit/secrets.toml en local,
# ou renseigner ces clés dans Streamlit Cloud → App → Settings → Secrets.

APP_PASSWORD = "change-me-mot-de-passe-equipe"

OPENROUTER_API_KEY = "sk-or-v1-..."
# Clé à générer dans Vekta → Settings → API keys (https://app.joinvekta.com/me/settings/api-keys)
VEKTA_API_KEY = "vk_..."
# Optionnel — l'URL correcte est déjà dans le code :
# VEKTA_BASE_URL = "https://api.joinvekta.com"

# Optionnel — accélère PubMed (gratuit sur ncbi.nlm.nih.gov) :
PUBMED_EMAIL = "coach.wt@equipe.com"
PUBMED_API_KEY = ""

# Optionnel — pont TrainingPeaks (lecture seule). Identifiants de ton compte
# coach TP (les mêmes que WKO5 utilise). RESTE PRIVÉ : ne jamais partager.
# TP_USERNAME = "ton-email-ou-user-tp"
# TP_PASSWORD = "mot-de-passe-tp"

# ── Protocoles d'échauffement WU24 (PRIVÉ) ──────────────────────
# Le code public ne contient que les titres. Colle ici tes valeurs
# réelles. Champs requis par protocole ci-dessous (placeholders 0) ;
# champs optionnels si sprintReps > 0 : sprintWork, sprintRec,
# sprintEasyBefore. Répéter pour : standard, prologo, ttt, hot,
# quiet, gt (ou tout autre identifiant de ton choix).

[WU_PROTOCOLS.standard]
duration = 0
z3blocks = [0, 0, 0]
z3easy = 0
z3pctHR = [0.0, 0.0, 0.0]
z3capPct = 0.0
z4reps = 0
z4work = 0.0
z4rec = 0.0
z4loPct = 0.0
z4hiPct = 0.0
easyAfterZ4 = 0
z5reps = 0
z5work = 0.0
z5rec = 0.0
z5loPct = 0.0
z5hiPct = 0.0
sprintReps = 0
